{
  "rewrites": [
    { "source": "/r/:code", "destination": "/r.html" }
  ],
  "redirects": [
    { "source": "/privacy", "destination": "https://thanosrokkas.github.io/underneath-privacy/", "permanent": false },
    { "source": "/terms", "destination": "https://thanosrokkas.github.io/underneath-privacy/terms", "permanent": false }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
